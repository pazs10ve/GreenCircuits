{
  "name": "@greencircuits/db",
  "version": "0.1.0",
  "private": true,
  "description": "Typed database access (Kysely) generated from the SQL schema in db/, and the demo-data loader.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "codegen": "kysely-codegen --config-file .kysely-codegenrc.json",
    "seed": "tsx src/seed/index.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@greencircuits/market": "workspace:*",
    "kysely": "^0.28",
    "pg": "^8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "kysely-codegen": "^0.19",
    "tsx": "^4",
    "typescript": "^5"
  }
}
