# Local development defaults. Copy to .env and adjust; .env is git-ignored.

POSTGRES_PASSWORD=greencircuits
GC_DB_PORT=55432
GC_VALKEY_PORT=6380
MINIO_ROOT_PASSWORD=greencircuits-dev

DATABASE_URL=postgres://greencircuits:greencircuits@localhost:55432/greencircuits
VALKEY_URL=redis://localhost:6380

# Market feed for the ingestor: simulator | yahoo (real, delayed prices for local use; see
# docs/adr/0007). Empty picks yahoo once `pnpm data:real` has loaded real data, else the simulator.
FEED_PROVIDER=

# Broker API credentials live only on the backend host. Never commit them.
SMARTAPI_API_KEY=
SMARTAPI_CLIENT_CODE=
FYERS_APP_ID=
FYERS_SECRET_KEY=
