{
  "name": "@greencircuits/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify REST API (/v1): instruments, quotes, candles, companies, the market brief, IPOs and bonds.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --dir src",
    "test:integration": "vitest run --dir test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@greencircuits/contracts": "workspace:*",
    "@greencircuits/db": "workspace:*",
    "@greencircuits/market": "workspace:*",
    "bullmq": "^6.3.9",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.28",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
